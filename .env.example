# ── Ollama ────────────────────────────────────────────────────
# URL of the local Ollama server (default: localhost)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for compliance analysis
OLLAMA_MODEL=mistral

# Request timeout in seconds (large prompts can be slow on CPU)
OLLAMA_TIMEOUT=120

# ── Analysis settings ─────────────────────────────────────────
# FedRAMP baseline: low | moderate
FEDRAMP_BASELINE=low

# Max Terraform resources to analyse in one run (0 = unlimited)
MAX_RESOURCES=0

# ── Output ────────────────────────────────────────────────────
# Directory where reports and OSCAL packages are written
OUTPUT_DIR=./output

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Webhook (optional) ────────────────────────────────────────
# POST a scan summary here after every scan (e.g. an n8n webhook;
# see examples/n8n). Leave empty to disable.
FEDRAMP_WEBHOOK_URL=

# Signs the webhook body (HMAC-SHA256); set the same value in the receiver
FEDRAMP_WEBHOOK_SECRET=
