# ── Ollama ────────────────────────────────────────────────────
# URL of the local Ollama server (default: localhost)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for compliance analysis
OLLAMA_MODEL=mistral

# Request timeout in seconds (large prompts can be slow on CPU)
OLLAMA_TIMEOUT=120

# ── Analysis settings ─────────────────────────────────────────
# FedRAMP baseline: low | moderate
FEDRAMP_BASELINE=low

# Max Terraform resources to analyse in one run (0 = unlimited)
MAX_RESOURCES=0

# ── Output ────────────────────────────────────────────────────
# Directory where reports and OSCAL packages are written
OUTPUT_DIR=./output

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
