# Shared with fedramp-auto (same value on both sides). Generate one with:
#   openssl rand -hex 32
FEDRAMP_WEBHOOK_SECRET=

# owner/repo to open and close issues in. Leave empty to skip GitHub.
FEDRAMP_GITHUB_REPO=

# Which new gaps get an issue
FEDRAMP_ISSUE_SEVERITIES=critical,high

# Slack incoming-webhook URL. Leave empty to skip Slack.
FEDRAMP_SLACK_WEBHOOK_URL=

# Public base URL if n8n is behind a proxy or tunnel (used for webhook URLs)
WEBHOOK_URL=http://localhost:5678/

TZ=UTC
# N8N_VERSION=
